# Copia este archivo como .env.local y agrega tu clave de Vercel AI Gateway.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev

# Desarrollo local: si queda vacío, usa data/electroagenda.db.
SQLITE_DB_PATH=data/electroagenda.db

# Producción en Vercel: agrega la URL de tu Postgres/Neon.
# DATABASE_URL=postgresql://usuario:password@host/base?sslmode=require

# Opcional: conserva la API directa de Jev usando JEV_API_KEY.
# JEV_API_KEY=
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
